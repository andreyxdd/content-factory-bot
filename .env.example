# Telegram
BOT_TOKEN=

# Comma-separated Telegram user ids (numeric)
ALLOWLIST_TELEGRAM_IDS=

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://cfbot:cfbot@localhost:5432/content_factory

# App
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-domain.example
OAUTH_STATE_SECRET=change-me-long-random

# LLM — OpenRouter (see .planning/MODEL-MATRIX.md)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_RESEARCH=perplexity/sonar-pro
LLM_MODEL_RESEARCH_FALLBACK=perplexity/sonar
LLM_MODEL_DRAFT=anthropic/claude-sonnet-4
LLM_MODEL_DRAFT_FALLBACK=openai/gpt-4o
LLM_MODEL_IMAGE=black-forest-labs/flux-1.1-pro
LLM_MODEL_IMAGE_FALLBACK=openai/dall-e-3
LLM_MODEL_FAST=openai/gpt-4o-mini
LLM_MODEL_FAST_FALLBACK=google/gemini-2.5-flash
LLM_MODEL_REVIEW=openai/gpt-4o
LLM_MODEL_REVIEW_FALLBACK=anthropic/claude-sonnet-4

# Worker (v1)
REDIS_URL=redis://localhost:6379/0

# Storage + secrets (gap closures)
CREDENTIALS_ENCRYPTION_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth (Phase 4+) — hosted on FastAPI sidecar
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
